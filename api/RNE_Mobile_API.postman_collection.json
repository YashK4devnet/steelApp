{
    "info": {
        "name": "Mobile API",
        "description": "Postman collection for the RNE application APIs. One app; data and screens depend on the user's role (Security, Seller, Transporter, Buyer, Admin).",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "1. Login",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "const jsonData = pm.response.json();",
                            "if (jsonData && jsonData.status === 'success' && jsonData.token) {",
                            "    pm.collectionVariables.set('token', jsonData.token);",
                            "    console.log('Token saved:', jsonData.token);",
                            "}"
                        ]
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Username",
                        "value": "{{username}}"
                    },
                    {
                        "key": "Password",
                        "value": "{{password}}"
                    },
                    {
                        "key": "X-Odoo-Database",
                        "value": "{{db}}"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/booking/auth/login",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "booking",
                        "auth",
                        "login"
                    ]
                },
                "description": "Authenticate with username and password. Returns the user's persistent mobile token (generated on first login, reused afterwards), saved to the collection variable 'token' for subsequent requests."
            },
            "response": []
        },
        {
            "name": "2. Logout",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{token}}"
                    },
                    {
                        "key": "X-Odoo-Database",
                        "value": "{{db}}"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/booking/auth/logout",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "booking",
                        "auth",
                        "logout"
                    ]
                },
                "description": "Signs out the current session. The token is not deleted or rotated and remains valid for future logins."
            },
            "response": []
        },
        {
            "name": "3. Loaded Trucks",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "const jsonData = pm.response.json();",
                            "if (jsonData && jsonData.trucks && jsonData.trucks.length > 0) {",
                            "    const truck = jsonData.trucks.find(t => !t.is_reported) || jsonData.trucks[0];",
                            "    pm.collectionVariables.set('truck_line_id', truck.id);",
                            "    console.log('Truck line ID set to:', truck.id);",
                            "}"
                        ]
                    }
                }
            ],
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{token}}"
                    },
                    {
                        "key": "X-Odoo-Database",
                        "value": "{{db}}"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/booking/trucks/loaded",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "booking",
                        "trucks",
                        "loaded"
                    ]
                },
                "description": "Fetch loaded trucks waiting for unloading. The first unreported truck id is saved to the variable 'truck_line_id'."
            },
            "response": []
        },
        {
            "name": "4. Report Truck",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{token}}"
                    },
                    {
                        "key": "X-Odoo-Database",
                        "value": "{{db}}"
                    }
                ],
                "body": {
                    "mode": "formdata",
                    "formdata": [
                        {
                            "key": "truck_line_id",
                            "value": "{{truck_line_id}}",
                            "type": "text"
                        },
                        {
                            "key": "reporting_datetime",
                            "value": "{{reporting_datetime}}",
                            "type": "text"
                        },
                        {
                            "key": "note",
                            "value": "Truck arrived at gate",
                            "type": "text"
                        },
                        {
                            "key": "image_1",
                            "value": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg==",
                            "type": "text"
                        },
                        {
                            "key": "image_2",
                            "value": "",
                            "type": "text"
                        },
                        {
                            "key": "image_3",
                            "value": "",
                            "type": "text"
                        }
                    ]
                },
                "url": {
                    "raw": "{{baseUrl}}/booking/trucks/report",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "booking",
                        "trucks",
                        "report"
                    ]
                },
                "description": "Report a truck arrival. Requires an unreported truck_line_id (set automatically after a successful Loaded Trucks call)."
            },
            "response": []
        },
        {
            "name": "5. Loading Trucks",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "const jsonData = pm.response.json();",
                            "if (jsonData && jsonData.trucks && jsonData.trucks.length > 0) {",
                            "    const truck = jsonData.trucks[0];",
                            "    pm.collectionVariables.set('loading_truck_line_id', truck.id);",
                            "    console.log('Loading truck line ID set to:', truck.id);",
                            "}"
                        ]
                    }
                }
            ],
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{token}}"
                    },
                    {
                        "key": "X-Odoo-Database",
                        "value": "{{db}}"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/booking/trucks/loading",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "booking",
                        "trucks",
                        "loading"
                    ]
                },
                "description": "Fetch trucks currently in Loading state. Sellers see only trucks assigned to their pickup location; Admins see all. The first truck id is saved to 'loading_truck_line_id'."
            },
            "response": []
        },
        {
            "name": "6. Submit Vendor Bill",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{token}}"
                    },
                    {
                        "key": "X-Odoo-Database",
                        "value": "{{db}}"
                    }
                ],
                "body": {
                    "mode": "formdata",
                    "formdata": [
                        {
                            "key": "truck_line_id",
                            "value": "{{loading_truck_line_id}}",
                            "type": "text"
                        },
                        {
                            "key": "bill_number",
                            "value": "INV/2026/0001",
                            "type": "text"
                        },
                        {
                            "key": "bill_date",
                            "value": "2026-07-28",
                            "type": "text"
                        },
                        {
                            "key": "bill_document",
                            "value": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg==",
                            "type": "text"
                        },
                        {
                            "key": "eway_bill_attached_with_bill",
                            "value": "false",
                            "type": "text"
                        },
                        {
                            "key": "eway_bill_number",
                            "value": "123456789012",
                            "type": "text"
                        },
                        {
                            "key": "eway_bill_document",
                            "value": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg==",
                            "type": "text"
                        }
                    ]
                },
                "url": {
                    "raw": "{{baseUrl}}/booking/trucks/submit_vendor_bill",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "booking",
                        "trucks",
                        "submit_vendor_bill"
                    ]
                },
                "description": "Submit vendor bill and optional E-Way Bill for a loading truck. Reuses the same fields and validation as the Odoo loading flow."
            },
            "response": []
        },
        {
            "name": "7. Transporter Loading Trucks",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "const jsonData = pm.response.json();",
                            "if (jsonData && jsonData.trucks && jsonData.trucks.length > 0) {",
                            "    const truck = jsonData.trucks.find(t => !t.is_bilty_submitted) || jsonData.trucks[0];",
                            "    pm.collectionVariables.set('transporter_truck_line_id', truck.id);",
                            "    console.log('Transporter truck line ID set to:', truck.id);",
                            "}"
                        ]
                    }
                }
            ],
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{token}}"
                    },
                    {
                        "key": "X-Odoo-Database",
                        "value": "{{db}}"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/booking/trucks/transporter/loading",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "booking",
                        "trucks",
                        "transporter",
                        "loading"
                    ]
                },
                "description": "Transporter-only. Fetch the logged-in transporter's trucks currently in Loading state. is_bilty_submitted indicates whether the related loading record already has a bilty document. The first truck without a bilty is saved to 'transporter_truck_line_id'."
            },
            "response": []
        },
        {
            "name": "8. Submit Bilty",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{token}}"
                    },
                    {
                        "key": "X-Odoo-Database",
                        "value": "{{db}}"
                    }
                ],
                "body": {
                    "mode": "formdata",
                    "formdata": [
                        {
                            "key": "truck_line_id",
                            "value": "{{transporter_truck_line_id}}",
                            "type": "text"
                        },
                        {
                            "key": "bilty_document",
                            "type": "file",
                            "src": ""
                        },
                        {
                            "key": "bilty_document_name",
                            "value": "bilty.pdf",
                            "type": "text"
                        }
                    ]
                },
                "url": {
                    "raw": "{{baseUrl}}/booking/trucks/submit_bilty",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "booking",
                        "trucks",
                        "submit_bilty"
                    ]
                },
                "description": "Transporter-only. Upload the bilty document for a loading truck assigned to the logged-in transporter. Saves to transport.loading bilty_document and bilty_document_name."
            },
            "response": []
        },
        {
            "name": "7. Outgoing Trucks",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "const jsonData = pm.response.json();",
                            "if (jsonData && jsonData.trucks && jsonData.trucks.length > 0) {",
                            "    const truck = jsonData.trucks.find(t => !t.is_reported) || jsonData.trucks[0];",
                            "    pm.collectionVariables.set('outgoing_truck_id', truck.id);",
                            "    console.log('Outgoing truck ID set to:', truck.id);",
                            "}"
                        ]
                    }
                }
            ],
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{token}}"
                    },
                    {
                        "key": "X-Odoo-Database",
                        "value": "{{db}}"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/booking/trucks/outgoing",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "booking",
                        "trucks",
                        "outgoing"
                    ]
                },
                "description": "Fetch outgoing draft trucks waiting to be reported. The first unreported truck id is saved to 'outgoing_truck_id'."
            },
            "response": []
        },
        {
            "name": "8. Report Outgoing Truck",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{token}}"
                    },
                    {
                        "key": "X-Odoo-Database",
                        "value": "{{db}}"
                    }
                ],
                "body": {
                    "mode": "formdata",
                    "formdata": [
                        {
                            "key": "truck_id",
                            "value": "{{outgoing_truck_id}}",
                            "type": "text"
                        },
                        {
                            "key": "reporting_datetime",
                            "value": "{{reporting_datetime}}",
                            "type": "text"
                        },
                        {
                            "key": "note",
                            "value": "Outgoing truck reported at gate",
                            "type": "text"
                        },
                        {
                            "key": "image_1",
                            "value": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg==",
                            "type": "text"
                        },
                        {
                            "key": "image_2",
                            "value": "",
                            "type": "text"
                        },
                        {
                            "key": "image_3",
                            "value": "",
                            "type": "text"
                        }
                    ]
                },
                "url": {
                    "raw": "{{baseUrl}}/booking/trucks/outgoing/report",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "booking",
                        "trucks",
                        "outgoing",
                        "report"
                    ]
                },
                "description": "Report an outgoing truck. Requires an unreported truck_id from GET /booking/trucks/outgoing."
            },
            "response": []
        },
        {
            "name": "9. Customer Master Data",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{token}}"
                    },
                    {
                        "key": "X-Odoo-Database",
                        "value": "{{db}}"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/booking/customer/master-data",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "booking",
                        "customer",
                        "master-data"
                    ]
                },
                "description": "Buyer only: dropdown data for the truck request screen (warehouses, ship-to, bill-to, UOMs, truck types). Admin and other roles get 403."
            },
            "response": []
        },
        {
            "name": "10. Customer Products",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{token}}"
                    },
                    {
                        "key": "X-Odoo-Database",
                        "value": "{{db}}"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/booking/customer/products",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "booking",
                        "customer",
                        "products"
                    ]
                },
                "description": "Buyer only: approved saleable products with image_128 (base64) and bundle options for DIA selection. Admin and other roles get 403."
            },
            "response": []
        },
        {
            "name": "11. Submit Truck Request",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "const jsonData = pm.response.json();",
                            "if (jsonData && jsonData.status === 'success' && jsonData.truck_id) {",
                            "    pm.collectionVariables.set('customer_truck_id', jsonData.truck_id);",
                            "    console.log('Customer truck ID set to:', jsonData.truck_id);",
                            "}"
                        ]
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{token}}"
                    },
                    {
                        "key": "X-Odoo-Database",
                        "value": "{{db}}"
                    },
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"is_seller_truck\": false,\n  \"warehouse_id\": 1,\n  \"ship_to_address_id\": 40,\n  \"is_same_as_ship_to\": true,\n  \"truck_number_plate\": \"KA-01-AB-1234\",\n  \"truck_capacity_ton\": 16.5,\n  \"is_new_truck_type\": false,\n  \"truck_type_id\": 7,\n  \"driver_name\": \"Rajesh Kumar\",\n  \"driver_contact\": \"+91 91234 56789\",\n  \"dia_details\": [\n    {\n      \"dia\": \"12mm\",\n      \"shape_id\": 1,\n      \"weight_type_id\": 3,\n      \"uom_id\": 1,\n      \"qty_selection\": \"by_weight\",\n      \"weight\": 10.5\n    }\n  ]\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/booking/customer/truck-request",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "booking",
                        "customer",
                        "truck-request"
                    ]
                },
                "description": "Buyer only: create a truck booking, or update a booking in draft, accepted, or rejected by sending truck_id. When is_seller_truck is true, truck and driver fields are not required. Saves truck_id to customer_truck_id."
            },
            "response": []
        },
        {
            "name": "12. Customer Trucks List",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "const jsonData = pm.response.json();",
                            "if (jsonData && jsonData.trucks && jsonData.trucks.length > 0) {",
                            "    pm.collectionVariables.set('customer_truck_id', jsonData.trucks[0].id);",
                            "    console.log('Customer truck ID set to:', jsonData.trucks[0].id);",
                            "}"
                        ]
                    }
                }
            ],
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{token}}"
                    },
                    {
                        "key": "X-Odoo-Database",
                        "value": "{{db}}"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/booking/customer/trucks",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "booking",
                        "customer",
                        "trucks"
                    ]
                },
                "description": "Buyer only: list the customer's truck.from.warehouse bookings (state != cancelled). The first truck id is saved to customer_truck_id."
            },
            "response": []
        },
        {
            "name": "13. Customer Truck Details",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{token}}"
                    },
                    {
                        "key": "X-Odoo-Database",
                        "value": "{{db}}"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/booking/customer/trucks/{{customer_truck_id}}",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "booking",
                        "customer",
                        "trucks",
                        "{{customer_truck_id}}"
                    ]
                },
                "description": "Buyer only: full details of one customer truck booking, including dia_details and qty_selection. Use this payload to edit, then POST /booking/customer/truck-request with truck_id."
            },
            "response": []
        },
        {
            "name": "14. Cancel Customer Truck",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{token}}"
                    },
                    {
                        "key": "X-Odoo-Database",
                        "value": "{{db}}"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/booking/customer/trucks/{{customer_truck_id}}/cancel",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "booking",
                        "customer",
                        "trucks",
                        "{{customer_truck_id}}",
                        "cancel"
                    ]
                },
                "description": "Buyer only: cancel own truck booking when state is draft, accepted, rejected, or loading."
            },
            "response": []
        }
    ],
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:8069",
            "description": "Your Odoo instance base URL."
        },
        {
            "key": "username",
            "value": "",
            "description": "Odoo username or email."
        },
        {
            "key": "password",
            "value": "",
            "description": "Odoo password."
        },
        {
            "key": "db",
            "value": "",
            "description": "Database name (optional if auto-detected)."
        },
        {
            "key": "token",
            "value": "",
            "description": "Filled automatically by the Login request."
        },
        {
            "key": "truck_line_id",
            "value": "",
            "description": "Filled automatically by the Loaded Trucks request (first unreported truck)."
        },
        {
            "key": "reporting_datetime",
            "value": "2026-07-28 12:30:00",
            "description": "UTC datetime in YYYY-MM-DD HH:MM:SS format."
        },
        {
            "key": "outgoing_truck_id",
            "value": "",
            "description": "Filled automatically by the Outgoing Trucks request (first unreported truck)."
        },
        {
            "key": "customer_truck_id",
            "value": "",
            "description": "Filled automatically by Submit Truck Request or Customer Trucks List."
        },
        {
            "key": "transporter_truck_line_id",
            "value": "",
            "description": "Filled automatically by Transporter Loading Trucks (first truck without a submitted bilty)."
        }
    ]
}